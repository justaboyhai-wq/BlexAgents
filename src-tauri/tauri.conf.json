{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BlexAgent",
  "version": "0.7.2",
  "identifier": "com.blexagents.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run validate:bundled-resources && npm run build:web && npm run build:server && npm run build:bridge && npm run build:cli"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.blexagent/**"]
      },
      "csp": "default-src 'self' ipc: tauri: asset: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: tauri: asset: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://download.blexagent.com; img-src 'self' data: blob: asset: blexagent: http://blexagent.localhost http://asset.localhost https://asset.localhost https://download.blexagent.com https:; media-src 'self' blob: asset: blexagent: http://blexagent.localhost http://asset.localhost https://asset.localhost;",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "杭州波粒二象文化科技有限公司",
    "copyright": "Copyright © 2026 杭州波粒二象文化科技有限公司. Apache-2.0 licensed.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "A desktop personal Agent for creators, everyday life, education, and productive work.",
    "longDescription": "BlexAgent brings conversations, workspaces, tools, tasks, skills, and personal AI workflows into one local-first desktop application.",
    "targets": ["dmg", "app", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src-tauri/resources/server-dist.js": "server-dist.js",
      "../src-tauri/resources/plugin-bridge-dist.mjs": "plugin-bridge-dist.mjs",
      "../src/server/plugin-bridge/sdk-shim": "plugin-bridge-sdk-shim",
      "../src-tauri/resources/claude-agent-sdk": "claude-agent-sdk",
      "../src-tauri/resources/sharp-runtime": "sharp-runtime",
      "../src-tauri/resources/tsx-runtime": "tsx-runtime",
      "../src-tauri/resources/nodejs": "nodejs",
      "../src/shared": "shared",
      "../bundled-skills": "bundled-skills",
      "../bundled-agents": "bundled-agents",
      "../src-tauri/resources/cli": "cli",
      "../mino": "mino",
      "../agenthub": "agenthub",
      "../LICENSE": "legal/LICENSE",
      "../NOTICE": "legal/NOTICE",
      "../TRADEMARKS.md": "legal/TRADEMARKS.md",
      "../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../specs/legal/OFFICIAL_DISTRIBUTION_TERMS.md": "legal/OFFICIAL_DISTRIBUTION_TERMS.md",
      "../specs/legal/PRIVACY.md": "legal/PRIVACY.md",
      "infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "infoplist/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings"
    },
    "externalBin": ["binaries/cuse"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": null,
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "SimpChinese": "nsis/languages/SimpChinese.nsh",
          "English": "nsis/languages/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0RTRBOERFOTZCNkU0MTAKUldRUTVMYVczcWpraEZKcVVBMldIdWI4NXNQQWx2RjJ3MVdNVmxVR1RlSE50Y0tBcmlTVG1SckwK",
      "endpoints": ["https://download.blexagent.com/update/{{target}}.json"]
    }
  }
}
